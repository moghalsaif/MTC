# ── BACKEND (set these in Railway) ────────────────────────────────────────────

# PostgreSQL connection string — Railway auto-fills this when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Strong random secret for JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-very-long-random-secret-key-here

# CORS: set to your Vercel frontend URL in production
CORS_ORIGINS=https://your-app.vercel.app

# Leave empty to allow ALL email addresses to register (good for trial)
ALLOWED_EMAIL_DOMAIN=

# These emails automatically get admin/manager roles on first login
ADMIN_EMAIL=sanat@machvisuals.com
MANAGER_EMAIL=rohit@machvisuals.com

# ── FRONTEND (set this in Vercel) ──────────────────────────────────────────────

# Your Railway backend public URL
REACT_APP_BACKEND_URL=https://your-backend.up.railway.app
